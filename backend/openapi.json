{
  "openapi": "3.1.0",
  "info": {
    "title": "Bot Varejo API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/public/health": {
      "get": {
        "tags": [
          "public",
          "health"
        ],
        "summary": "Health check do escopo public",
        "operationId": "getPublicHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/health": {
      "get": {
        "tags": [
          "admin",
          "health"
        ],
        "summary": "Health check do escopo admin",
        "operationId": "getAdminHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentHealthResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "ComponentHealthResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "uptimeSeconds": {
            "type": "number",
            "title": "Uptimeseconds"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Checkedat"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/ComponentHealthResponse"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "status",
          "scope",
          "version",
          "uptimeSeconds",
          "checkedAt",
          "components"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "down"
        ],
        "title": "HealthStatus"
      },
      "Scope": {
        "type": "string",
        "enum": [
          "public",
          "admin"
        ],
        "title": "Scope",
        "description": "Escopo de acesso da aplicação. Define prefixos de rota e regras futuras de auth."
      }
    }
  }
}
