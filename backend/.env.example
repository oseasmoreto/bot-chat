# Copie para .env e ajuste. Variáveis APP_* são lidas pelo Settings (pydantic-settings).
# Comentários sempre em linha própria (não no fim da linha do valor).

# --- Aplicação ---------------------------------------------------------------
# local · dev · staging · production
APP_ENV=local
# Versão exibida no health; na imagem de produção vem de --build-arg APP_VERSION
APP_VERSION=0.0.0-local
# DEBUG · INFO · WARNING · ERROR
APP_LOG_LEVEL=INFO
# Liga /api/docs, /api/redoc e /api/openapi.json
APP_DOCS_ENABLED=true
# Onde `python main.py` escuta. Dentro do container mantenha 8000 (mude a porta do host com API_PORT)
APP_HOST=0.0.0.0
APP_PORT=8000
# Origens do frontend, em JSON. Vale para CORS e para o Origin do WebSocket
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- DynamoDB (docs/12-persistencia-dynamodb.md) --------------------------------
APP_AWS_REGION=sa-east-1
APP_DYNAMODB_TABLE_PREFIX=bot-varejo-local
# No docker compose o endpoint já é http://bot-varejo-dynamodb:8000.
# Rodando a API fora do Docker, use o DynamoDB Local publicado no host:
# APP_DYNAMODB_ENDPOINT_URL=http://localhost:8001

# --- Uvicorn -------------------------------------------------------------------
# Proxies confiáveis para X-Forwarded-*
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Portas publicadas no host (docker compose) --------------------------------
API_PORT=8000
DYNAMODB_PORT=8001
