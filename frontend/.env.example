# Copie para .env e ajuste. Comentários sempre em linha própria.

# --- Runtime do frontend (lidas pelo servidor Next a cada requisição) ----------
# URLs da API como o NAVEGADOR enxerga (a API sobe pelo compose do backend)
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000

# --- Porta publicada no host (docker compose) ----------------------------------
WEB_PORT=3000

# --- Testes E2E (Playwright) --------------------------------------------------
# Front testado pelos E2E; o Playwright não sobe nada, só usa esta URL
E2E_BASE_URL=http://localhost:3000

# --- Ferramentas de desenvolvimento --------------------------------------------
# Origem do contrato para pnpm openapi
OPENAPI_URL=http://localhost:8000/api/openapi.json
